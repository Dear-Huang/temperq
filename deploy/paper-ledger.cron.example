# Replace both absolute paths. Run as the owner of the private workbench.
# Update the daily-data feed before this task. Inspect /paper for WAITING_DATA/BLOCKED.
0 18 * * 1-5 cd /path/to/quant-workbench && /path/to/quant-workbench/.venv/bin/python -X utf8 -m qwb.cli paper tick --all >> runs/paper-scheduler.log 2>&1
